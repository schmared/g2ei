# sources/README.md says how to fetch them.
/sources/*
!/sources/README.md

# Python
__pycache__/
*.py[cod]

# Editors and OS
.claude/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# The tools' working files: drafts, transcriptions, scans, second-pass replies, reports, pickles
/tools/work/
